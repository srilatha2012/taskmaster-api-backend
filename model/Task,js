const mongoose = require("mongoose");

//Define task schema
const taskSchema = new mongoose.Schema({
    title: {
        type: String,
        required: true,
        unique: true,
    },
    description: {
        type: String
    },
    status: {
        type: String,
        rquired: true,
        default: "In Progress"
    },
    project: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'Project',
        required: true,
    }
});

//Create Task module with taskSchema
const Task = mongoose.model("Task", taskSchema);

module.exports = Task;